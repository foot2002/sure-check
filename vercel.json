{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/evidence/capture/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "app/api/scan/start/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/scan/file/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/revalidate/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/report/admin/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/internal/collector/run",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/internal/collector/revalidate",
      "schedule": "0 3 * * *"
    }
  ]
}
