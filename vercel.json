{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/evidence/capture/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "app/api/scan/start/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/scan/file/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/run/a/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/collector/run/b/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/collector/revalidate/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/diagnosis-dispatch/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/report/admin/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/internal/collector/run/a",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/internal/collector/run/b",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/internal/collector/revalidate",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/internal/collector/revalidate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/collector/revalidate",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "0 11 * * *"
    }
  ]
