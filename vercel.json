{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/evidence/capture/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "app/api/scan/start/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/scan/file/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/run/a/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/collector/run/b/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/collector/revalidate/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/internal/collector/diagnosis-dispatch/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/collector/official-sites/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/internal/jobs/run-next/route.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "app/api/internal/weekly/publish/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/report/admin/collector/run/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/report/admin/collector/diagnose/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/internal/collector/official-sites",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/collector/official-sites",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/internal/collector/official-sites",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/internal/collector/official-sites",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/internal/collector/diagnosis-dispatch",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/internal/jobs/run-next",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/internal/jobs/run-next",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/internal/weekly/publish",
      "schedule": "30 15 * * *"
    }
  ]
}
