# SURE Check 환경변수 예시
# 이 파일을 복사해 `.env.local`로 사용하세요.
# 실제 비밀값은 절대 커밋하지 마세요.

# ─── Supabase (프로젝트: sure-check) ───
# Dashboard → Project Settings → API
# 서버 전용 — 브라우저에 노출하지 마세요
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
SUPABASE_EVIDENCE_BUCKET=evidence-files

# ─── 관리자 리포트 (/report/admin) ───
# 서버 전용 — 절대 커밋하지 마세요
REPORT_ADMIN_PASSWORD=change-me-strong-password
REPORT_ADMIN_SESSION_SECRET=change-me-long-random-secret

# ─── 비동기 작업 워커 / 동시성 ───
# 내부 복구 워커 보호 토큰 (POST /api/internal/jobs/run-next)
INTERNAL_WORKER_TOKEN=change-me-internal-worker-token
# 일반 진단 동시 처리 수
SCAN_WORKER_CONCURRENCY=3
# 신고용 캡처 동시 처리 수 (Playwright/Puppeteer — 낮게 유지)
CAPTURE_WORKER_CONCURRENCY=1
# 진단/캡처 타임아웃(초)
SCAN_JOB_TIMEOUT_SECONDS=60
CAPTURE_JOB_TIMEOUT_SECONDS=180
# 문항 추출용 browser fallback 타임아웃(초) — 증빙 캡처에는 적용하지 않음
BROWSER_EXTRACT_TIMEOUT_SECONDS=30
# 동일 URL 완료 결과 캐시 TTL(초)
SCAN_CACHE_TTL_SECONDS=3600
# Status polling stale thresholds (seconds)
SCAN_STATUS_STALE_SECONDS=90
CAPTURE_STATUS_STALE_SECONDS=240
# Client UI hard stop for scan polling (ms)
SCAN_CLIENT_HARD_TIMEOUT_MS=120000
# IP당 분당 진단 시작 제한 / pending 상한
SCAN_RATE_LIMIT_PER_IP_PER_MINUTE=5
MAX_PENDING_JOBS_PER_IP=3

# (개발 전용) 신고용 캡처 start 실패 시 동기 /api/evidence/capture fallback 허용
# NEXT_PUBLIC_ALLOW_SYNC_CAPTURE_FALLBACK=1

# ─── 배포 검증 (scripts/verify-production-readiness.ts) ───
# VERIFY_BASE_URL=http://localhost:8080
# VERIFY_BASE_URL=https://sure-check.vercel.app
# VERIFY_INTERNAL_WORKER_TOKEN=  # 기본: INTERNAL_WORKER_TOKEN
# VERIFY_ADMIN_PASSWORD=         # 기본: REPORT_ADMIN_PASSWORD

# (선택) 클라이언트 anon 키 — 현재 연결 확인에는 사용하지 않음
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# ─── 공개 설문 링크 수집기 (/report/admin/collector) ───
# NAVER API HUB (https://naverapihub.apigw.ntruss.com)
# 헤더: X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
# 미설정 시 서버는 기동되지만 수집 기능만 비활성화됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Cron 전용: GET|POST /api/internal/collector/run , /revalidate
# Vercel Cron Jobs는 Authorization: Bearer ${CRON_SECRET} 을 자동 전송합니다.
# COLLECTOR_CRON_SECRET 또는 CRON_SECRET 중 하나 이상 설정 (동일 값 권장).
COLLECTOR_CRON_SECRET=change-me-collector-cron-secret
# CRON_SECRET=change-me-collector-cron-secret
#
# 검색 전략 (resolveCollectorSearchStrategy):
#   unset / legacy     → legacy (즉시 rollback 값)
#   org_v1 | org_v1.2 | org_v1_2 | org_v1.1 | org_v1_1 | org-v1 | v2
#                      → 내부 strategy "org_v1" (= org_v1.2 triage 경로 runOrgV11Collection)
# Production fast-track canary 권장:
#   COLLECTOR_SEARCH_STRATEGY=org_v1.2
#   COLLECTOR_CANARY=1
# Rollback:
#   COLLECTOR_SEARCH_STRATEGY=legacy   (또는 변수 삭제)
#   COLLECTOR_CANARY=0                 (또는 변수 삭제)
# COLLECTOR_SEARCH_STRATEGY=legacy
# COLLECTOR_CANARY=0
# DB: apply db/migrations/004–006 (006 = collection_query_stats per-query metrics)
#
# Vercel Cron (production 배포 후 활성화, 스케줄 변경 없음):
# - 수집: 매일 21:00 UTC = 06:00 KST → /api/internal/collector/run
# - 재검증: 매일 03:00 UTC = 12:00 KST → /api/internal/collector/revalidate
# Dashboard: Project → Settings → Environment Variables / Cron Jobs
# Fast-track: Cron 대기 없이 수동으로 run 1회 + revalidate discovered 최대 3회

# ─── 앱 설정 ───
# KISA 개인정보침해 신고센터 URL (신고 CTA 버튼)
NEXT_PUBLIC_KISA_REPORT_URL=https://privacy.kisa.or.kr

# (선택) 로컬 자동 화면 캡처용 Chrome/Edge 경로
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
