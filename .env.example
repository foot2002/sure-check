# SURE Check 환경변수 예시
# 이 파일을 복사해 `.env.local`로 사용하세요.
# 실제 비밀값은 절대 커밋하지 마세요.

# ─── Supabase (프로젝트: sure-check) ───
# Dashboard → Project Settings → API
# 서버 전용 — 브라우저에 노출하지 마세요
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
SUPABASE_EVIDENCE_BUCKET=evidence-files

# ─── 관리자 리포트 (/report/admin) ───
# 서버 전용 — 절대 커밋하지 마세요
REPORT_ADMIN_PASSWORD=change-me-strong-password
REPORT_ADMIN_SESSION_SECRET=change-me-long-random-secret

# ─── 비동기 작업 워커 / 동시성 ───
# 내부 복구 워커 보호 토큰 (POST /api/internal/jobs/run-next)
INTERNAL_WORKER_TOKEN=change-me-internal-worker-token
# 일반 진단 동시 처리 수
SCAN_WORKER_CONCURRENCY=3
# 신고용 캡처 동시 처리 수 (Playwright/Puppeteer — 낮게 유지)
CAPTURE_WORKER_CONCURRENCY=1
# 진단/캡처 타임아웃(초)
SCAN_JOB_TIMEOUT_SECONDS=60
CAPTURE_JOB_TIMEOUT_SECONDS=180
# 동일 URL 완료 결과 캐시 TTL(초)
SCAN_CACHE_TTL_SECONDS=3600

# (선택) 클라이언트 anon 키 — 현재 연결 확인에는 사용하지 않음
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# ─── 앱 설정 ───
# KISA 개인정보침해 신고센터 URL (신고 CTA 버튼)
NEXT_PUBLIC_KISA_REPORT_URL=https://privacy.kisa.or.kr

# (선택) 로컬 자동 화면 캡처용 Chrome/Edge 경로
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
